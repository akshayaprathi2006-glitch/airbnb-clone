<description xmlns="http://www.w3.org/ns/wsdl"
    xmlns:tns="http://www.tmsws.com/wsdl20sample"
    xmlns:whttp="http://schemas.xmlsoap.org/wsdl/http/"
    xmlns:wsoap="http://schemas.xmlsoap.org/wsdl/soap/"
    targetNamespace="http://www.tmsws.com/wsdl20sample">

  <documentation> Add your service description here </documentation>

  <!-- Abstract type -->
  <types>
    <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns="http://www.tmsws.com/wsdl20sample"
        targetNamespace="http://www.example.com/wsdl20sample">
      <xs:element name="request">
        <xs:complexType>
          <xs:all>
            <xs:element name="tickerSymbol" type="xs:string" />
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="response">
        <xs:complexType>
          <xs:all>
            <xs:element name="price" type="xs:float" />
          </xs:all>
        </xs:complexType>
      </xs:element>
    </xs:schema>
  </types>

  <!-- Abstract interfaces -->
  <interface name="Interface1">
    <fault name="Error1" element="tns:response" />
    <operation name="Get" pattern="http://www.w3.org/ns/wsdl/in-out">
      <input messageLabel="In" element="tns:request" />
      <output messageLabel="Out" element="tns:response" />
    </operation>
  </interface>

  <!-- Concrete Binding with SOAP -->
  <binding name="SoapBinding"
      interface="tns:Interface1"
      type="http://www.w3.org/ns/wsdl/soap"
      wsoap:protocol="http://www.w3.org/2003/05/soap/bindings/HTTP/"
      wsoap:mepDefault="http://www.w3.org/2003/05/soap/mep/request-response">
    <operation ref="tns:Get" />
  </binding>

  <!-- Web Service offering endpoints for corresponding bindings -->
  <service name="Service1" interface="tns:Interface1">
    <endpoint name="SoapEndpoint" binding="tns:SoapBinding" address="http://www.example.com/soap/" />
  </service>
</description>
`,wsdl1:()=>`<?xml version="1.0" encoding="UTF-8"?>
<definitions name="StockQuote"
    targetNamespace="http://example.com/stockquote.wsdl"
    xmlns:tns="http://example.com/stockquote.wsdl"
    xmlns:xsd1="http://example.com/stockquote.xsd"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns="http://schemas.xmlsoap.org/wsdl/">

  <!-- Abstract type -->
  <types>
    <schema targetNamespace="http://example.com/stockquote.xsd"
        xmlns="http://www.w3.org/2001/XMLSchema">
      <element name="TradePriceRequest">
        <complexType>
          <all>
            <element name="tickerSymbol" type="string" />
          </all>
        </complexType>
      </element>
      <element name="TradePrice">
        <complexType>
          <all>
            <element name="price" type="float" />
          </all>
        </complexType>
      </element>
    </schema>
  </types>

  <!-- Abstract messages -->
  <message name="GetLastTradePriceInput">
    <part name="body" element="xsd1:TradePriceRequest" />
  </message>

  <message name="GetLastTradePriceOutput">
    <part name="body" element="xsd1:TradePrice" />
  </message>

  <!-- Abstract portTypes -->
  <portType name="StockQuotePortType">
    <operation name="GetLastTradePrice">
      <input message="tns:GetLastTradePriceInput" />
      <output message="tns:GetLastTradePriceOutput" />
    </operation>
  </portType>

  <!-- Concrete Binding with SOAP-->
  <binding name="StockQuoteBinding" type="tns:StockQuotePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http" />
    <operation name="GetLastTradePrice">
      <soap:operation soapAction="http://example.com/GetLastTradePrice" />
      <input>
        <soap:body use="literal" />
      </input>
      <output>
        <soap:body use="literal" />
      </output>
    </operation>
  </binding>

  <!-- Web Service offering ports-->
  <service name="StockQuoteService">
    <documentation> Add your service description here </documentation>
    <port name="StockQuotePort" binding="tns:StockQuoteBinding">
      <soap:address location="http://example.com/stockquote" />
    </port>
  </service>

</definitions>
`,proto3:()=>`syntax = "proto3";

package com.book;

message Book {
  int64 isbn = 1;
  string title = 2;
  string author = 3;
}

message GetBookRequest {
  int64 isbn = 1;
}

message GetBookViaAuthor {
  string author = 1;
}

service BookService {
  rpc GetBook (GetBookRequest) returns (Book) {}
  rpc GetBooksViaAuthor (GetBookViaAuthor) returns (stream Book) {}
  rpc GetGreatestBook (stream GetBookRequest) returns (Book) {}
  rpc GetBooks (stream GetBookRequest) returns (stream Book) {}
}
`,proto2:()=>`syntax = "proto2";

package com.addressBook;

message Person {
  required string name = 1;
  required int32 id = 2;
  optional string email = 3;
}

message AddressBook {
  repeated Person people = 1;
}

message AddressBookById {
  required int32 id = 1;
}

message AddressBookByName {
  required string name = 1;
}

service AddressBookService {
  rpc CreateAddressBook (AddressBook) returns (AddressBook) {}
  rpc GetAddressBook (AddressBookById) returns (AddressBook) {}
  rpc ListAddressBook (AddressBookByName) returns (stream AddressBook) {}
}`,asyncapi2:{json:e=>{let{version:t}=e;return`{
  "asyncapi": "2.5.0",
  "info": {
    "title": "Streetlights API",
    "version": "${t}",
    "description": "The Smartylighting Streetlights API allows you to remotely manage the city lights.",
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "contact": {
      "name": "Streetlights API Developers",
      "url": "https://example.com/contact",
      "email": "contact@example.com"
    },
    "termsOfService": "https://www.apache.org/licenses/LICENSE-2.0"
  },
  "servers": {
    "mosquitto": {
      "url": "mqtt://test.mosquitto.org",
      "protocol": "mqtt"
    }
  },
  "channels": {
    "light/measured": {
      "publish": {
        "summary": "Inform about environmental lighting conditions for a particular streetlight",
        "operationId": "onLightMeasured",
        "message": {
          "name": "LightMeasured",
          "payload": {
            "$ref": "#/components/schemas/LightMeasuredPayloadSchema"
          },
          "examples": [
            {
              "payload": {
                "id": 1,
                "lumens": 1,
                "sentAt": "2023-09-01T18:00:00.000Z"
              }
            }
          ]
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LightMeasuredPayloadSchema": {
        "type": "object",
        "description": "Payload for LightMeasured API",
        "required": [
          "id",
          "lumens",
          "sentAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "description": "Id of the streetlight"
          },
          "lumens": {
            "type": "integer",
            "minimum": 0,
            "description": "Light intensity measured in lumens"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time when the message was sent",
            "minLength": 20,
            "maxLength": 29
          }
        }
      }
    }
  }
}`},yaml:e=>{let{version:t}=e;return`asyncapi: '2.5.0'
info:
  title: Streetlights API
  version: '${t}'
  description: |
    The Smartylighting Streetlights API allows you
    to remotely manage the city lights.
  license:
    name: Apache 2.0
    url: 'https://www.apache.org/licenses/LICENSE-2.0'
  contact:
    name: Streetlights API Developers
    url: https://example.com/contact
    email: contact@example.com
  termsOfService: https://www.apache.org/licenses/LICENSE-2.0
servers:
  mosquitto:
    url: mqtt://test.mosquitto.org
    protocol: mqtt
channels:
  light/measured:
    publish:
      summary: Inform about environmental lighting conditions for a particular streetlight
      operationId: onLightMeasured
      message:
        name: LightMeasured
        payload:
          $ref: '#/components/schemas/LightMeasuredPayloadSchema'
        examples:
          - payload:
              id: 1
              lumens: 1
              sentAt: 2023-09-01T18:00:00Z
components:
  schemas:
    LightMeasuredPayloadSchema:
      type: object
      description: Payload for LightMeasured API
      required:
        - id
        - lumens
        - sentAt
      properties:
        id:
          type: integer
          minimum: 0
          description: Id of the streetlight
        lumens:
          type: integer
          minimum: 0
          description: Light intensity measured in lumens
        sentAt:
          type: string
          format: date-time
          description: Date and time when the message was sent
          minLength: 20
          maxLength: 29`}}}},"../../packages/api-design/api-definition-ui/src/components/DefinitionImport/templates/index.js"(e,t,r){"use strict";r.d(t,{k:()=>d});var n=r("../../node_modules/lodash/lodash.min.js"),o=r.n(n),i=r("../../packages/api-design/api-definition-ui/src/components/DefinitionImport/templates/boilerplates/index.js");let s="sample",a={[s]:{allowedDataKeys:{title:{default:"Sample API"},version:{default:"1.0"}}}},l=(e,t)=>{let r=o().get(i.A,[s,e,t])||o().get(i.A,[s,e]);if("function"!=typeof r)throw Error("Template function is not defined");return r},c=function(e){let t=arguments.length>1&&void 0!==arguments[1]?arguments[1]:{};return Object.keys(e.allowedDataKeys||{}).forEach(r=>{r in t||(t[r]=e.allowedDataKeys[r].default)}),t},d={getAvailableTemplates:()=>Object.keys(a),isTemplateNameConfigured:e=>!!(a[e]&&"object"==typeof a[e]),getBoilerplate:(e,t)=>{let{type:r,language:n,data:o}=t;if(!d.isTemplateNameConfigured(e))throw Error("Template name is not defined");return l(r,n)(o=c(a[e],o))}}},"../../packages/api-design/api-definition-ui/src/constants/private-network.js"(e,t,r){"use strict";r.d(t,{x:()=>n});let n={API_DEFINITION:"apiDefinition",API_DEFINITION_FILE:"apiFile"}},"../../packages/api-design/api-definition-ui/src/constants/urls.js"(e,t,r){"use strict";r.d(t,{Y:()=>n});let n={HOME:"home",FILE:"file"}},"../../packages/api-design/api-definition-ui/src/utils/Definition.js"(e,t,r){"use strict";r.d(t,{AX:()=>b,Jw:()=>S,fF:()=>A,kB:()=>_});var n=r("../../node_modules/react/index.js");r("../../node_modules/mobx/lib/mobx.module.js");var o=r("./js/stores/StoreManager.js"),i=r("../../packages/api-design/api-definition-store/src/APIDefinitionStore.js"),s=r("../../packages/api-design/api-definition-store/src/services/APIDefinitionTypeService.js"),a=r("./api-dev/stores/APIListStore.js"),l=r("./api-dev/services/APIPermissionService.js"),c=r("./api-dev/interfaces/APIInterface.js"),d=r("../../platform-libs/navigation-runtime/src/index.ts"),u=r("../../packages/