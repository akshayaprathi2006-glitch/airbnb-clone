"__WP_ANALYTICS_URL__":"\'https://events.getpostman.com/events\'","__WP_ANALYTICS_CLICK_EVENT_URL__":"\'https://events.getpostman.com/click-events\'","__WP_ENABLE_CRASH_REPORTING__":false,"__WP_SENTRY_DSN__":"\'https://8f5498484cd64c1180faeda80abe39b6@o1224273.ingest.sentry.io/6459827\'","__WP_TRIAL_DURATION__":2592000000,"__WP_DATABASE_NAME__":"\'postman\'","__WP_SYNC_RAWTEXT_LIMIT__":5242880,"__WP_DISABLE_ANALYTICS__":false,"__WP_DISABLE_UPDATES__":false,"__WP_CORS_ORIGIN_HEADER__":"\'https://client.postman.co\'","__WP_TRUSTED_DOMAINS__":["\'getpostman.com\'","\'postman.co\'","\'postman.com\'"],"__WP_SKILL_SERVICE_URL__":"\'https://skill.gw.postman.com/v1\'","__WP_LIVE_URL__":"\'https://live.postman.com\'","__WP_MCP_UI_PROXY_URL__":"\'https://client-proxy.pstmn.io/index.v1.html\'","__WP_MCP_APPS_PROXY_URL__":"\'https://client-proxy.pstmn.io/mcp-apps-proxy.html\'","__WP_ONBOARDING_SERVICE_URL__":"\'https://onb.gw.postman.com\'","__WP_ENABLE_ANALYTICS_LOG__":false,"__WP_ARTEMIS_URL__":"\'https://go.postman.co\'","__WP_POSTMAN_AGENT_DOWNLOAD_URL__":"\'https://dl-agent.pstmn.io/download/latest\'","__WP_NEWMAN_DOWNLOAD_URL__":"\'https://go.pstmn.io/install-newman\'","__WP_RUNTIME_ASSETS_URL__":"\'https://runtime-assets.pstmn.io\'","__WP_RUNTIME_AGENT_PORT__":10505,"__WP_RUNTIME_AGENT_SERVICE_URL__":"\'https://runtime-agent.getpostman.com/v1\'","__WP_CLOUD_AGENT_SERVICE_URL__":"\'https://orion-http.gw.postman.co\'","__WP_PACKMAN_SERVICE_URL__":"\'https://packman.pstmn.io\'","__WP_ARTEMIS_DOMAIN__":"\'.postman.co\'","__WP_CONFIG_TYPE__":"\'gw\'","__WP_LAUNCHDARKLY_CLIENTSIDE_ID__":"\'\'","__WP_AMPLITUDE_CLIENTSIDE_ID__":"\'\'","__WP_AMPLITUDE_API_KEY__":"\'\'","__WP_AMPLITUDE_BASE_URL__":"\'\'","__WP_SEGMENT_BASE_URL__":"\'https://api.segment.io/v1/batch\'","__WP_AMPLITUDE_ENVIRONMENT__":"\'development\'","__WP_API_GOVERNANCE_ASSETS_URL__":"\'https://governance-static.pstmn.io\'","__WP_OG_ASSETS_BASE_URL__":"\'https://assets.publish.postman.com\'","__WP_API_AUTH_PUBLIC_B